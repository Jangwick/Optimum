{
  "name": "claims-solutions-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "docxtemplater": "3.69.3",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "express": "4.22.2",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "nanoid": "6.0.1",
    "pdfkit": "0.19.1",
    "pino": "10.3.1",
    "puppeteer": "25.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "jest": "30.4.2",
    "@prisma/adapter-mariadb": "7.9.1",
    "mariadb": "3.5.3",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "supertest": "7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "bcrypt@6.0.0": true,
    "prisma@7.9.1": true,
    "puppeteer@25.5.0": true,
    "unrs-resolver@1.12.2": true
  }
}
