NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

DATABASE_URL="mysql://root:@localhost:3306/claims_solutions?schema=public"

JWT_SECRET=change-this-to-a-64-character-random-hex-string
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Required for the default admin account on first seed.
# Use a strong, unique value in production.
DEFAULT_ADMIN_PASSWORD=SetAStrongPasswordHere

UPLOAD_DIR=./uploads
REPORT_DIR=./reports
TEMPLATE_DIR=./templates

# Hard cap is 104857600 (100MB); values above this fail validation.
MAX_FILE_SIZE=20971520
