generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("roles")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @db.VarChar(255)
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  phone          String?  @db.VarChar(50)
  employeeNumber String?  @unique @db.VarChar(50)
  department     String?  @db.VarChar(100)
  designation    String?  @db.VarChar(100)
  roleId         Int
  role           Role     @relation(fields: [roleId], references: [id])
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdClaims           Claim[]              @relation("ClaimCreatedBy")
  engineerClaims          Claim[]              @relation("ClaimEngineer")
  accountantClaims        Claim[]              @relation("ClaimAccountant")
  closedClaims            Claim[]              @relation("ClaimClosedBy")
  assignments             ClaimAssignment[]    @relation("ClaimAssignmentUser")
  assignmentsCreated      ClaimAssignment[]    @relation("AssignmentAssignedBy")
  statusHistory           ClaimStatusHistory[]
  investigationsCompleted Investigation[]
  inspectionsAsInspector  Inspection[]         @relation("InspectionInspector")
  photosUploaded          InspectionPhoto[]
  documentsUploaded       Document[]
  lossAssessmentsPrepared LossAssessment[]     @relation("LossAssessmentPreparedBy")
  lossEstimatesPrepared   LossEstimate[]       @relation("LossEstimatePreparedBy")
  reportsGenerated        Report[]             @relation("ReportGeneratedBy")
  reportVersionsGenerated ReportVersion[]      @relation("ReportVersionGeneratedBy")
  clarificationsAsked     Clarification[]      @relation("ClarificationAskedBy")
  clarificationsAnswered  Clarification[]      @relation("ClarificationAnsweredBy")
  settlementsCreated      Settlement[]
  offersCreated           Offer[]              @relation("OfferCreatedBy")
  offersResponded         Offer[]              @relation("OfferResponseBy")
  fees                    Fee[]
  invoicesCreated         Invoice[]
  tasksAssigned           Task[]               @relation("TaskAssignedTo")
  tasksCreated            Task[]               @relation("TaskCreatedBy")
  notifications           Notification[]
  auditLogs               AuditLog[]
  processStatusHistory    ClaimProcessStatusHistory[]
  activities              ClaimActivity[]
  correspondenceCreated   ClaimCorrespondence[]
  importBatches           ClaimImportBatch[]
  adjusterAliases         AdjusterAlias[]
  discussionNotesCreated  DiscussionNote[]    @relation("DiscussionNoteCreatedBy")

  @@map("users")
}

model InsuranceCompany {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  code          String?  @unique @db.VarChar(50)
  contactPerson String?  @db.VarChar(100)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address       String?  @db.Text
  policies      Policy[]
  claims        Claim[]
  claimInsurers ClaimInsurer[]
  aliases       InsuranceCompanyAlias[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("insurance_companies")
}

model Client {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  code          String?  @unique @db.VarChar(50)
  contactPerson String?  @db.VarChar(100)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address       String?  @db.Text
  policies      Policy[]
  claims        Claim[]
  aliases       ClientAlias[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("clients")
}

model Policy {
  id                 Int              @id @default(autoincrement())
  policyNumber       String           @unique @db.VarChar(100)
  insuranceCompanyId Int
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  clientId           Int
  client             Client           @relation(fields: [clientId], references: [id])
  claimTypeId        Int
  claimType          ClaimType        @relation(fields: [claimTypeId], references: [id])
  coverageDetails    String?          @db.Text
  policyType         String?          @db.VarChar(100)
  startDate          DateTime
  endDate            DateTime?
  sumInsured         Decimal?         @db.Decimal(18,2)
  premium            Decimal?         @db.Decimal(18,2)
  excess             Decimal?         @db.Decimal(18,2)
  notes              String?          @db.Text
  claims             Claim[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  @@map("policies")
}

model ClaimType {
  id          Int                   @id @default(autoincrement())
  name        String                @db.VarChar(100)
  code        String                @unique @db.VarChar(50)
  description String?               @db.Text
  policies    Policy[]
  claims      Claim[]
  aliases     ClaimTypeAlias[]
  requirements DocumentRequirement[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  @@map("claim_types")
}

model ClaimStatus {
  id         Int                    @id @default(autoincrement())
  name       String                 @unique @db.VarChar(50)
  code       String                 @unique @db.VarChar(50)
  color      String?                @db.VarChar(20)
  isTerminal Boolean                @default(false)
  sortOrder  Int                    @default(0)
  claims     Claim[]
  history    ClaimStatusHistory[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  @@map("claim_statuses")
}

model ProcessStatus {
  id         Int                         @id @default(autoincrement())
  name       String                      @unique @db.VarChar(100)
  code       String                      @unique @db.VarChar(50)
  color      String?                     @db.VarChar(20)
  isTerminal Boolean                     @default(false)
  sortOrder  Int                         @default(0)
  claims     Claim[]
  history    ClaimProcessStatusHistory[]
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  @@map("process_statuses")
}

model ImportStatus {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(100)
  code      String  @unique @db.VarChar(50)
  sortOrder Int     @default(0)
  claims    Claim[]
  @@map("import_statuses")
}

model Broker {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  code          String?  @unique @db.VarChar(50)
  contactPerson String?  @db.VarChar(150)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address       String?  @db.Text
  claims        Claim[]
  aliases       BrokerAlias[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("brokers")
}

model InsuranceCompanyAlias {
  id                 Int              @id @default(autoincrement())
  alias              String           @unique @db.VarChar(255)
  normalizedAlias    String           @unique @db.VarChar(255)
  insuranceCompanyId Int
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  @@map("insurance_company_aliases")
}

model ClientAlias {
  id              Int      @id @default(autoincrement())
  alias           String   @unique @db.VarChar(255)
  normalizedAlias String   @unique @db.VarChar(255)
  clientId        Int
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@map("client_aliases")
}

model BrokerAlias {
  id              Int      @id @default(autoincrement())
  alias           String   @unique @db.VarChar(255)
  normalizedAlias String   @unique @db.VarChar(255)
  brokerId        Int
  broker          Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@map("broker_aliases")
}

model AdjusterAlias {
  id              Int      @id @default(autoincrement())
  alias           String   @unique @db.VarChar(100)
  normalizedAlias String   @unique @db.VarChar(100)
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@map("adjuster_aliases")
}

model ClaimTypeAlias {
  id              Int       @id @default(autoincrement())
  alias           String    @unique @db.VarChar(255)
  normalizedAlias String    @unique @db.VarChar(255)
  claimTypeId     Int
  claimType       ClaimType @relation(fields: [claimTypeId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  @@map("claim_type_aliases")
}

model Claim {
  id                 Int               @id @default(autoincrement())
  claimNumber        String            @unique @db.VarChar(100)
  assignmentNumber   String?           @unique @db.VarChar(100)
  insurerClaimNumber String?           @db.VarChar(150)
  claimTypeId        Int?
  claimType          ClaimType?        @relation(fields: [claimTypeId], references: [id])
  policyId           Int?
  policy             Policy?           @relation(fields: [policyId], references: [id])
  clientId           Int?
  client             Client?           @relation(fields: [clientId], references: [id])
  insuranceCompanyId Int?
  insuranceCompany   InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  brokerId           Int?
  broker             Broker?           @relation(fields: [brokerId], references: [id])
  brokerReference    String?            @db.VarChar(150)
  engineerId         Int?
  engineer           User?              @relation("ClaimEngineer", fields: [engineerId], references: [id])
  accountantId       Int?
  accountant         User?              @relation("ClaimAccountant", fields: [accountantId], references: [id])
  statusId           Int
  status             ClaimStatus       @relation(fields: [statusId], references: [id])
  processStatusId    Int?
  processStatus      ProcessStatus?     @relation(fields: [processStatusId], references: [id])
  createdById        Int
  createdBy          User              @relation("ClaimCreatedBy", fields: [createdById], references: [id])
  closedById         Int?
  closedBy           User?             @relation("ClaimClosedBy", fields: [closedById], references: [id])
  importBatchId      Int?
  importBatch        ClaimImportBatch? @relation(fields: [importBatchId], references: [id])
  importRowId        Int?               @unique
  importRow          ClaimImportRow?    @relation("CommittedClaim", fields: [importRowId], references: [id])
  duplicateImportRows ClaimImportRow[]  @relation("DuplicateImportRow")

  dateOfLoss              DateTime?
  dateReceived            DateTime  @default(now())
  assignedByName          String?   @db.VarChar(150)
  natureOfLoss            String?   @db.Text
  locationOfLoss          String?   @db.Text
  description             String?   @db.Text
  policyPeriodText        String?   @db.Text
  policyCoverageText      String?   @db.Text
  claimedAmount           Decimal?  @db.Decimal(18,2)
  claimedAmountRaw        String?   @db.Text
  reserve                 Decimal?  @db.Decimal(18,2)
  reserveRaw              String?   @db.Text
  estimatedLoss           Decimal?  @db.Decimal(18,2)
  actualLoss              Decimal?  @db.Decimal(18,2)
  proposedSettlement      Decimal?  @db.Decimal(18,2)
  proposedSettlementRaw   String?   @db.Text
  agreedSettlement        Decimal?  @db.Decimal(18,2)
  agreedSettlementRaw     String?   @db.Text
  deductible              Decimal?  @db.Decimal(18,2)
  depreciation            Decimal?  @db.Decimal(18,2)
  adjustedLoss            Decimal?  @db.Decimal(18,2)
  classification          String?   @db.VarChar(50)
  remarksRaw              String?   @db.LongText
  latestStatusRaw         String?   @db.LongText
  letterFollowUpRaw       String?   @db.Text
  handlingAdjuster        String?   @db.VarChar(100)
  dateInspected           DateTime?
  letterRequestDate       DateTime?
  denialLetterDate        DateTime?
  contactRaw              String?   @db.Text
  policyNumber            String?   @db.VarChar(100)
  policyType              String?   @db.VarChar(100)
  isIncomplete            Boolean   @default(false)
  incompleteReasons       Json?
  importedAt              DateTime?
  lastUserModifiedAt      DateTime?
  isClosed                Boolean   @default(false)
  closedAt                DateTime?
  isCancelled             Boolean   @default(false)
  isReadOnly              Boolean   @default(false)
  cancellationReason      String?   @db.Text
  importStatusId          Int?
  importStatus            ImportStatus? @relation(fields: [importStatusId], references: [id])
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  assignments          ClaimAssignment[]
  statusHistory        ClaimStatusHistory[]
  processStatusHistory ClaimProcessStatusHistory[]
  insurerPanel         ClaimInsurer[]
  activities           ClaimActivity[]
  correspondence       ClaimCorrespondence[]
  investigations       Investigation[]
  contacts             Contact[]
  inspections          Inspection[]
  documents            Document[]
  lossAssessments      LossAssessment[]
  lossEstimates        LossEstimate[]
  reports              Report[]
  settlements          Settlement[]
  offers               Offer[]
  fees                 Fee[]
  invoices             Invoice[]
  tasks                Task[]
  notifications        Notification[]
  discussionNotes      DiscussionNote[]

  @@index([statusId])
  @@index([processStatusId])
  @@index([engineerId])
  @@index([accountantId])
  @@index([clientId])
  @@index([insuranceCompanyId])
  @@index([brokerId])
  @@index([claimNumber])
  @@index([dateReceived])
  @@index([importBatchId])
  @@index([importStatusId])
  @@index([isReadOnly])
  @@map("claims")
}

model ClaimAssignment {
  id           Int       @id @default(autoincrement())
  claimId      Int
  claim        Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId       Int
  user         User      @relation("ClaimAssignmentUser", fields: [userId], references: [id])
  role         String    @db.VarChar(50)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  assignedById Int
  assignedBy   User      @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@map("claim_assignments")
}

model ClaimStatusHistory {
  id          Int         @id @default(autoincrement())
  claimId     Int
  claim       Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  statusId    Int
  status      ClaimStatus @relation(fields: [statusId], references: [id])
  changedById Int
  changedBy   User        @relation(fields: [changedById], references: [id])
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  @@map("claim_status_history")
}

model ClaimProcessStatusHistory {
  id             Int           @id @default(autoincrement())
  claimId        Int
  claim          Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  processStatusId Int
  processStatus  ProcessStatus @relation(fields: [processStatusId], references: [id])
  changedById    Int
  changedBy      User          @relation(fields: [changedById], references: [id])
  notes          String?       @db.Text
  source         String        @default("USER") @db.VarChar(30)
  isOverride     Boolean       @default(false)
  overrideReason String?       @db.Text
  createdAt      DateTime      @default(now())
  @@index([claimId, createdAt])
  @@map("claim_process_status_history")
}

model Investigation {
  id            Int      @id @default(autoincrement())
  claimId       Int
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  summary       String?  @db.Text
  findings      String?  @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  completedById Int?
  completedBy   User?    @relation(fields: [completedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("investigations")
}

model Contact {
  id        Int      @id @default(autoincrement())
  claimId   Int
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(150)
  role      String?  @db.VarChar(100)
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(255)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("contacts")
}

model DiscussionNote {
  id          Int      @id @default(autoincrement())
  claimId     Int
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  partyType   String   @db.VarChar(50)
  partyName   String?  @db.VarChar(255)
  discussedAt DateTime @default(now())
  notes       String   @db.Text
  nextAction  String?  @db.Text
  createdById Int
  createdBy   User     @relation("DiscussionNoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([claimId, discussedAt])
  @@map("discussion_notes")
}

model ClaimInsurer {
  id                 Int              @id @default(autoincrement())
  claimId            Int
  claim              Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  insuranceCompanyId Int
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  isLead             Boolean          @default(false)
  participationPercent Decimal?       @db.Decimal(5,2)
  insurerClaimNumber String?          @db.VarChar(150)
  proposedSettlement Decimal?         @db.Decimal(18,2)
  proposedSettlementRaw String?       @db.Text
  agreedSettlement   Decimal?         @db.Decimal(18,2)
  agreedSettlementRaw String?         @db.Text
  paidAmount         Decimal?         @db.Decimal(18,2)
  offerStatus        String?          @db.VarChar(50)
  paymentStatus      String?          @db.VarChar(50)
  notes              String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  @@index([claimId])
  @@index([insuranceCompanyId])
  @@map("claim_insurers")
}

model ClaimActivity {
  id            Int      @id @default(autoincrement())
  claimId       Int
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  activityType  String   @db.VarChar(50)
  occurredAt    DateTime?
  description   String   @db.Text
  source        String   @default("USER") @db.VarChar(20)
  sourceText    String?  @db.Text
  confidence    String?  @db.VarChar(20)
  importRowId   Int?
  importRow     ClaimImportRow? @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  actorId       Int?
  actor         User?    @relation(fields: [actorId], references: [id])
  createdAt     DateTime @default(now())
  @@index([claimId, occurredAt])
  @@map("claim_activities")
}

model ClaimCorrespondence {
  id             Int      @id @default(autoincrement())
  claimId        Int
  claim          Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  type           String   @db.VarChar(50)
  sentAt         DateTime?
  receivedAt     DateTime?
  followUpDate   DateTime?
  recipient      String?  @db.VarChar(255)
  notes          String?  @db.Text
  isHistorical   Boolean  @default(false)
  documentId     Int?
  document       Document? @relation(fields: [documentId], references: [id])
  createdById    Int
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([claimId])
  @@map("claim_correspondence")
}

model Inspection {
  id          Int               @id @default(autoincrement())
  claimId     Int
  claim       Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  scheduledAt DateTime?
  conductedAt DateTime?
  location    String?           @db.VarChar(255)
  findings    String?           @db.Text
  notes       String?           @db.Text
  inspectorId Int?
  inspector   User?             @relation("InspectionInspector", fields: [inspectorId], references: [id])
  photos      InspectionPhoto[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@map("inspections")
}

model InspectionPhoto {
  id           Int        @id @default(autoincrement())
  inspectionId Int
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  fileName     String     @db.VarChar(255)
  originalName String     @db.VarChar(255)
  mimeType     String     @db.VarChar(100)
  path         String     @db.VarChar(500)
  data         Bytes?     @db.LongBlob
  size         Int
  caption      String?    @db.VarChar(255)
  uploadedById Int
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@map("inspection_photos")
}

model DocumentCategory {
  id           Int              @id @default(autoincrement())
  name         String           @unique @db.VarChar(100)
  code         String           @unique @db.VarChar(50)
  description  String?          @db.Text
  documents    Document[]
  requirements DocumentRequirement[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@map("document_categories")
}

model DocumentRequirement {
  id                 Int              @id @default(autoincrement())
  claimTypeId        Int
  claimType          ClaimType        @relation(fields: [claimTypeId], references: [id], onDelete: Cascade)
  documentCategoryId Int
  documentCategory   DocumentCategory @relation(fields: [documentCategoryId], references: [id], onDelete: Cascade)
  isRequired         Boolean          @default(true)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  @@unique([claimTypeId, documentCategoryId])
  @@map("document_requirements")
}

model Document {
  id                 Int               @id @default(autoincrement())
  claimId            Int
  claim              Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  documentCategoryId Int?
  documentCategory   DocumentCategory? @relation(fields: [documentCategoryId], references: [id])
  fileName           String            @db.VarChar(255)
  originalName       String            @db.VarChar(255)
  mimeType           String            @db.VarChar(100)
  path               String            @db.VarChar(500)
  data               Bytes?            @db.LongBlob
  size               Int
  description        String?           @db.Text
  uploadedById       Int
  uploadedBy         User              @relation(fields: [uploadedById], references: [id])
  isRequired         Boolean           @default(false)
  isReceived         Boolean           @default(false)
  receivedAt         DateTime?
  isHistorical       Boolean           @default(false)
  source             String            @default("USER") @db.VarChar(20)
  importBatchId      Int?
  sourceText         String?           @db.Text
  sourceRowNumber    Int?
  correspondence     ClaimCorrespondence[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  @@index([importBatchId])
  @@map("documents")
}

model LossAssessment {
  id             Int                  @id @default(autoincrement())
  claimId        Int
  claim          Claim                @relation(fields: [claimId], references: [id], onDelete: Cascade)
  preparedById   Int
  preparedBy     User                 @relation("LossAssessmentPreparedBy", fields: [preparedById], references: [id])
  assessmentDate DateTime             @default(now())
  totalAmount    Decimal?             @db.Decimal(18,2)
  depreciation   Decimal?             @db.Decimal(18,2)
  deductible     Decimal?             @db.Decimal(18,2)
  adjustedAmount Decimal?             @db.Decimal(18,2)
  notes          String?              @db.Text
  items          LossAssessmentItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  @@map("loss_assessments")
}

model LossAssessmentItem {
  id              Int            @id @default(autoincrement())
  lossAssessmentId Int
  lossAssessment  LossAssessment @relation(fields: [lossAssessmentId], references: [id], onDelete: Cascade)
  description     String         @db.VarChar(255)
  quantity        Int            @default(1)
  unitCost        Decimal?       @db.Decimal(18,2)
  amount          Decimal?       @db.Decimal(18,2)
  depreciation    Decimal?       @db.Decimal(18,2)
  deductible      Decimal?       @db.Decimal(18,2)
  adjustedAmount  Decimal?       @db.Decimal(18,2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@map("loss_assessment_items")
}

model LossEstimate {
  id           Int       @id @default(autoincrement())
  claimId      Int
  claim        Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  preparedById Int
  preparedBy   User      @relation("LossEstimatePreparedBy", fields: [preparedById], references: [id])
  estimateDate DateTime  @default(now())
  totalAmount  Decimal?  @db.Decimal(18,2)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@map("loss_estimates")
}

model ReportTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  type        String   @db.VarChar(50)
  fileName    String?  @db.VarChar(255)
  path        String?  @db.VarChar(500)
  description String?  @db.Text
  isDefault   Boolean  @default(false)
  reports     Report[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("report_templates")
}

model Report {
  id               Int            @id @default(autoincrement())
  claimId          Int
  claim            Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reportTemplateId Int
  reportTemplate   ReportTemplate @relation(fields: [reportTemplateId], references: [id])
  title            String         @db.VarChar(255)
  status           String         @db.VarChar(50)
  generatedAt      DateTime?
  generatedById    Int?
  generatedBy      User?          @relation("ReportGeneratedBy", fields: [generatedById], references: [id])
  docxPath         String?        @db.VarChar(500)
  pdfPath          String?        @db.VarChar(500)
  reportDate       DateTime?
  clientResponseDate DateTime?
  submittedAt      DateTime?
  revisedAt        DateTime?
  isHistorical     Boolean        @default(false)
  sourceText       String?        @db.Text
  statusText       String?        @db.VarChar(100)
  importBatchId    Int?
  notes            String?        @db.Text
  versions         ReportVersion[]
  clarifications   Clarification[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  @@index([importBatchId])
  @@map("reports")
}

model ReportVersion {
  id            Int      @id @default(autoincrement())
  reportId      Int
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  versionNumber Int
  docxPath      String?  @db.VarChar(500)
  pdfPath       String?  @db.VarChar(500)
  generatedAt   DateTime @default(now())
  generatedById Int
  generatedBy   User     @relation("ReportVersionGeneratedBy", fields: [generatedById], references: [id])
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  @@map("report_versions")
}

model Clarification {
  id           Int       @id @default(autoincrement())
  reportId     Int
  report       Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  question     String    @db.Text
  answer       String?   @db.Text
  askedById    Int
  askedBy      User      @relation("ClarificationAskedBy", fields: [askedById], references: [id])
  answeredById Int?
  answeredBy   User?     @relation("ClarificationAnsweredBy", fields: [answeredById], references: [id])
  askedAt      DateTime  @default(now())
  answeredAt   DateTime?
  status       String    @db.VarChar(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@map("clarifications")
}

model Settlement {
  id             Int       @id @default(autoincrement())
  claimId        Int
  claim          Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  settlementDate DateTime?
  settledAmount  Decimal?  @db.Decimal(18,2)
  status         String    @db.VarChar(50)
  notes          String?   @db.Text
  createdById    Int
  createdBy      User      @relation(fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@map("settlements")
}

model Offer {
  id            Int       @id @default(autoincrement())
  claimId       Int
  claim         Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  offerDate     DateTime  @default(now())
  offeredAmount Decimal?  @db.Decimal(18,2)
  status        String    @db.VarChar(50)
  responseDate  DateTime?
  responseById  Int?
  responseBy    User?     @relation("OfferResponseBy", fields: [responseById], references: [id])
  notes         String?   @db.Text
  createdById   Int
  createdBy     User      @relation("OfferCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@map("offers")
}

model Fee {
  id          Int       @id @default(autoincrement())
  claimId     Int
  claim       Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id])
  feeType     String    @db.VarChar(50)
  amount      Decimal   @db.Decimal(18,2)
  description String?   @db.Text
  isInvoiced  Boolean   @default(false)
  invoiceId   Int?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("fees")
}

model Invoice {
  id            Int       @id @default(autoincrement())
  claimId       Int
  claim         Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  invoiceNumber String    @unique @db.VarChar(100)
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  totalAmount   Decimal   @db.Decimal(18,2)
  status        String    @db.VarChar(50)
  notes         String?   @db.Text
  createdById   Int
  createdBy     User      @relation(fields: [createdById], references: [id])
  fees          Fee[]
  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@map("invoices")
}

model Payment {
  id          Int       @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentDate DateTime  @default(now())
  amount      Decimal   @db.Decimal(18,2)
  method      String?   @db.VarChar(50)
  reference   String?   @db.VarChar(100)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("payments")
}

model Task {
  id          Int       @id @default(autoincrement())
  claimId     Int?
  claim       Claim?    @relation(fields: [claimId], references: [id], onDelete: SetNull)
  assignedToId Int
  assignedTo  User      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  title       String    @db.VarChar(255)
  description String?   @db.Text
  dueDate     DateTime?
  status      String    @db.VarChar(50)
  priority    String    @db.VarChar(20)
  completedAt DateTime?
  createdById Int
  createdBy   User      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("tasks")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimId   Int?
  claim     Claim?   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@map("notifications")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  tableName String   @db.VarChar(100)
  recordId  String   @db.VarChar(50)
  action    String   @db.VarChar(50)
  oldValues Json?
  newValues Json?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())
  @@map("audit_logs")
}

model ClaimImportBatch {
  id              Int      @id @default(autoincrement())
  name            String?  @db.VarChar(255)
  fileName        String   @db.VarChar(255)
  filePath        String   @db.VarChar(500)
  fileSize        Int?
  fileHash        String?  @db.VarChar(255)
  status          String   @db.VarChar(50)
  sheetName       String?  @db.VarChar(100)
  sourceSheets    Json?
  headerMapping   Json?
  duplicateAction String?  @db.VarChar(20)
  totalRows       Int      @default(0)
  acceptedRows    Int      @default(0)
  flaggedRows     Int      @default(0)
  committedRows   Int      @default(0)
  committedAt     DateTime?
  rolledBackAt    DateTime?
  notes           String?  @db.Text
  importedById    Int
  importedBy      User     @relation(fields: [importedById], references: [id])
  claims          Claim[]
  rows            ClaimImportRow[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status])
  @@index([importedById])
  @@map("claim_import_batches")
}

model ClaimImportRow {
  id                  Int               @id @default(autoincrement())
  importBatchId       Int
  importBatch         ClaimImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  sourceSheet         String            @db.VarChar(100)
  sourceRowNumber     Int
  rawData             Json
  mappedData          Json?
  status              String            @db.VarChar(50)
  confidence          String?           @db.VarChar(20)
  inferredStatus      String?           @db.VarChar(100)
  issues              Json?
  duplicateOfClaimId  Int?
  duplicateOfClaim    Claim?            @relation("DuplicateImportRow", fields: [duplicateOfClaimId], references: [id], onDelete: SetNull)
  committedClaim      Claim?            @relation("CommittedClaim")
  committedAt         DateTime?
  rolledBackAt        DateTime?
  activities          ClaimActivity[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  @@index([importBatchId])
  @@index([status])
  @@index([duplicateOfClaimId])
  @@map("claim_import_rows")
}
