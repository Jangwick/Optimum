# Vercel + Supabase Environment Variables
# Set these in your Vercel project settings (Settings → Environment Variables)

# App
NODE_ENV=production
# Set CLIENT_URL to your Vercel domain (e.g. https://your-app.vercel.app)
CLIENT_URL=*

# Database — Supabase PostgreSQL
# Get this from Supabase: Project Settings → Database → Connection string
# Format: postgresql://postgres:PASSWORD@db.PROJECT.ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-64-character-random-hex-string
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# File storage (Vercel serverless has no persistent filesystem)
# Use /tmp for ephemeral storage, or configure S3/Supabase Storage
UPLOAD_DIR=/tmp/uploads
REPORT_DIR=/tmp/reports
TEMPLATE_DIR=./server/templates
MAX_FILE_SIZE=20971520

# Puppeteer (optional — PDF generation disabled on Vercel serverless)
# PUPPETEER_EXECUTABLE_PATH is not set; PDF generation will gracefully skip
