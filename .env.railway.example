# Railway Environment Variables
# Copy these into your application service variables (Variables tab).
# The root Dockerfile serves both client and API in one service.
# Replace placeholder values before deployment.

# App
NODE_ENV=production
PORT=3001
# Must be an explicit origin. "*" is REJECTED at boot (the server exits) because CORS
# runs with credentials:true -- a wildcard would let any site make authenticated
# requests with your users cookies. See server/src/config/index.ts.
# Use your Railway public domain (Settings -> Networking), or your custom domain.
CLIENT_URL=https://your-app.up.railway.app

# Database — use Railway's MySQL addon, not PostgreSQL.
# This reference resolves in Railway. Replace MySQL with the exact service name.
# For local use, replace it with a mysql:// connection string.
DATABASE_URL=${{MySQL.MYSQL_URL}}

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-64-character-random-hex-string
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
# Required when seeding a new database; choose your own strong password.
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# File storage (use /tmp for ephemeral storage on Railway)
UPLOAD_DIR=/tmp/uploads
REPORT_DIR=/tmp/reports
TEMPLATE_DIR=./templates
MAX_FILE_SIZE=20971520

# Puppeteer (set automatically by Dockerfile)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
