# Railway Environment Variables
# Copy these into your Railway service variables (Variables tab)

# App
NODE_ENV=production
PORT=3001
# Set CLIENT_URL to your Railway public domain (e.g. https://your-app.up.railway.app)
# Or leave as * to allow all origins
CLIENT_URL=*

# Database — use Railway's MySQL addon
# Railway will provide MYSQL_URL; map it to DATABASE_URL
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/claims_solutions

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-64-character-random-hex-string
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# File storage (use /tmp for ephemeral storage on Railway)
UPLOAD_DIR=/tmp/uploads
REPORT_DIR=/tmp/reports
TEMPLATE_DIR=./templates
MAX_FILE_SIZE=20971520

# Puppeteer (set automatically by Dockerfile)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
